{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firmware: enviar tudo e reiniciar",
      "type": "shell",
      "command": "python -m mpremote cp config.py e3634a.py bridge.py ble_uart.py selftest.py boot.py main.py : + reset",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Firmware: enviar arquivo aberto e reiniciar",
      "type": "shell",
      "command": "python -m mpremote cp \"${file}\" : + reset",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": []
    },
    {
      "label": "Firmware: REPL / log (sair com Ctrl+X)",
      "type": "shell",
      "command": "python -m mpremote repl",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Firmware: autoteste loopback",
      "type": "shell",
      "command": "python -m mpremote exec \"import selftest; selftest.loopback()\"",
      "problemMatcher": []
    },
    {
      "label": "Firmware: sondar fonte (probe)",
      "type": "shell",
      "command": "python -m mpremote exec \"import selftest; selftest.probe()\"",
      "problemMatcher": []
    },
    {
      "label": "Firmware: listar portas",
      "type": "shell",
      "command": "python -m mpremote connect list",
      "problemMatcher": []
    },
    {
      "label": "Testes no PC (simulador)",
      "type": "shell",
      "command": "python -m unittest discover -s tests -v",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "MicroPython: apagar flash (modo boot)",
      "type": "shell",
      "command": "python -m esptool --chip esp32c3 --port ${input:porta} erase_flash",
      "problemMatcher": []
    },
    {
      "label": "MicroPython: gravar interpretador (modo boot)",
      "type": "shell",
      "command": "python -m esptool --chip esp32c3 --port ${input:porta} write_flash -z 0x0 \"${input:binario}\"",
      "problemMatcher": []
    },
    {
      "label": "MicroPython: apagar + gravar interpretador",
      "dependsOrder": "sequence",
      "dependsOn": [
        "MicroPython: apagar flash (modo boot)",
        "MicroPython: gravar interpretador (modo boot)"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "porta",
      "type": "promptString",
      "description": "Porta serial (ex.: COM5 ou /dev/ttyACM0). Use 'Firmware: listar portas' para ver.",
      "default": "COM5"
    },
    {
      "id": "binario",
      "type": "promptString",
      "description": "Caminho do .bin do MicroPython ESP32_GENERIC_C3 baixado de micropython.org/download/ESP32_GENERIC_C3/"
    }
  ]
}
